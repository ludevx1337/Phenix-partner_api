# Supabase app client
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<publishable-or-anon-key>"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="<publishable-or-anon-key>"
SUPABASE_SERVICE_ROLE_KEY="<service-role-key-server-only>"

# Supabase database migrations
SUPABASE_DB_URL="postgresql://postgres:<db-password>@db.<project-ref>.supabase.co:5432/postgres"
SUPABASE_DB_SSL="true"

# Supabase Edge Function / Cron PHENIX
# Edge secrets must NOT start with SUPABASE_; use PROJECT_URL and SERVICE_ROLE_KEY in the Supabase dashboard.
PHENIX_MAINTENANCE_SECRET="change-me-long-random-secret"
PHENIX_OWNER_USER_ID=""
SDTR_BATCH_SIZE="50"
SDTR_CONCURRENCY="4"
SDTR_STALE_AFTER_MS="3300000"
PHENIX_REQUEST_TIMEOUT_MS="25000"

# Resend alertes DATA
RESEND_API_KEY="re_xxx"
RESEND_FROM="PHENIX <alerts@example.com>"
ALERT_ADMIN_EMAIL="admin@example.com"
RESEND_TIMEOUT_MS="20000"

# Notifications mobiles Pushover
PUSHOVER_APP_TOKEN=""
PUSHOVER_USER_KEY=""
PUSHOVER_PRIORITY="1"
PUSHOVER_DEVICE=""
PUSHOVER_SOUND=""
PUSHOVER_TIMEOUT_MS="10000"

# Admin bootstrap
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-with-a-strong-password"
ADMIN_DISPLAY_NAME="Administrateur"

# PHENIX API
PHENIX_API_BASE_URL="https://api.phenix-partner.fr"
PHENIX_USERNAME=""
PHENIX_PASSWORD=""
PHENIX_PARTENAIRE_ID=""
PHENIX_WEBHOOK_SECRET=""
PHENIX_CONFIG_ENCRYPTION_KEY=""
PHENIX_AUTH_STRICT_BODY="false"
PHENIX_AUTH_ERROR_COOLDOWN_MS="60000"
